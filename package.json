{
  "name": "ai-dairinin-kaigi",
  "productName": "MeetForMe",
  "version": "0.39.6",
  "description": "集まらなくても決まる、AI代理会議",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/engine.test.js && node test/server.test.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "jp.developershub.ai-dairinin-kaigi",
    "productName": "MeetForMe",
    "executableName": "kawarini-kaigi",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "sample-ai.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MeetForMe",
      "uninstallDisplayName": "MeetForMe",
      "artifactName": "meetforme-setup-${version}.${ext}"
    },
    "publish": null
  }
}